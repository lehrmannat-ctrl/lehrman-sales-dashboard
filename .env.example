# ---------------------------------------------------------------------------
# Lehrman Mobile Detail — Sales Dashboard
# Copy this file to .env.local and fill in real values.
# Never commit .env.local. Never expose service-role keys to the browser.
# ---------------------------------------------------------------------------

# --- Supabase (required) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used by API routes / cron jobs for privileged writes (sync jobs,
# alert generation). NEVER prefix this with NEXT_PUBLIC_ and never import it
# into a client component.
SUPABASE_SERVICE_ROLE_KEY=

# --- GoHighLevel (CRM: leads, opportunities, pipeline stages, activities) ---
GHL_API_KEY=
GHL_LOCATION_ID=
GHL_WEBHOOK_SECRET=

# --- Quo (phone tracking / call data) ---
QUO_API_KEY=
QUO_WEBHOOK_SECRET=

# --- OpenAI (AI call summaries: transcribes + summarizes GoHighLevel call
# recordings onto each lead's profile - see src/lib/integrations/call-summaries.ts
# and docs/integration-setup-guide.md "Call summaries (AI)") ---
OPENAI_API_KEY=

# --- Stripe (payment processor: source of truth for cash collected) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Urable (scheduling: source of truth for booked/completed jobs) ---
URABLE_API_KEY=
URABLE_ACCOUNT_ID=

# --- Meta Ads (source of truth for ad spend / CAC / ROAS) ---
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=

# --- QuickBooks Online (source of truth for the simple P&L section) ---
# These come from a QuickBooks Online API app you create at
# developer.intuit.com — NOT the same thing as the "Intuit QuickBooks"
# connector inside Claude chat. See docs/integration-setup-guide.md for the
# exact steps (create app -> connect to your real company -> OAuth playground
# to get a refresh token -> copy the realm/company ID).
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
QUICKBOOKS_REFRESH_TOKEN=
QUICKBOOKS_REALM_ID=
# "sandbox" while testing against a test company, unset/"production" once
# pointed at the real business.
QUICKBOOKS_ENVIRONMENT=

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Cron secret used to authenticate scheduled sync/alert-generation calls
CRON_SECRET=
